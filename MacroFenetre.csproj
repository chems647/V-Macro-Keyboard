<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MacroFenetre</AssemblyName>
    <RootNamespace>MacroFenetre</RootNamespace>
    <Product>MacroFenêtre</Product>
    <Description>Bascule ciblée entre fenêtres, macros de clic et séquences clavier/souris.</Description>
    <Version>0.4.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
