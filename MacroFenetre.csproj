<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VMacroKeyboard</AssemblyName>
    <RootNamespace>MacroFenetre</RootNamespace>
    <Product>V Macro Keyboard</Product>
    <Title>V Macro Keyboard</Title>
    <Description>Macros clavier et souris pour Dofus et les applications Windows.</Description>
    <ApplicationIcon>Assets\vmacro-app.ico</ApplicationIcon>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Resource Include="Assets\vmacro-app.ico" />
    <Resource Include="Assets\vmacro-app-icon.png" />
  </ItemGroup>
</Project>
